NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://mongo:27017/factoryflow?replicaSet=rs0
# Pour utiliser une base MongoDB existante sur Windows depuis Docker :
# DOCKER_MONGO_URI=mongodb://host.docker.internal:27017/factoryFlow?replicaSet=rs0&directConnection=true
SECRET_KEY=replace-with-a-long-random-secret

